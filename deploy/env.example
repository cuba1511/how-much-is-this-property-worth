# Reference only — do NOT copy to the server.
# Configure these as GitHub Environment "production" secrets / variables
# (Settings → Environments → production). Actions injects them into docker compose.

# ── Site (vars or secrets) ────────────────────────────────────────────────────
# SITE_ADDRESS=valoracion.tudominio.com
# ACME_EMAIL=tu@email.com

# ── Secrets ───────────────────────────────────────────────────────────────────
# BRIGHT_DATA_CDP=wss://brd-customer-...
# BRIGHT_DATA_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=PropHero <noreply@tudominio.com>
# HV_API_KEY=

# ── EC2 SSH (secrets, deploy job only) ────────────────────────────────────────
# EC2_HOST=1.2.3.4
# EC2_USER=ubuntu
# EC2_SSH_KEY=<private key PEM contents>
# EC2_APP_DIR=/home/ubuntu/how-much-is-this-property-worth
# EC2_REPO_URL=git@github.com:TU_ORG/how-much-is-this-property-worth.git
